# Base de datos SQLite (archivo local). En producción puedes usar una ruta persistente,
# por ejemplo file:/data/atn.db, o una base Turso/libSQL (libsql://...).
DATABASE_URL=file:./atn.db
# DATABASE_AUTH_TOKEN=   # solo si usas Turso

# Cadena larga y aleatoria. Genera una con: openssl rand -hex 32
PAYLOAD_SECRET=cambia-esto

# URL pública del sitio (sin / al final). Se usa en SEO: canonical, sitemap y Open Graph.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
