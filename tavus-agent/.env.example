TAVUS_API_KEY=
PORT=3000

# Resumen y datos del cliente al terminar cada llamada (cualquier API compatible con OpenAI).
# Gratis con Gemini: crea una clave en https://aistudio.google.com/apikey
SUMMARY_API_KEY=
SUMMARY_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
SUMMARY_MODEL=gemini-2.5-flash
# Con Ollama en tu Mac: SUMMARY_API_BASE=http://localhost:11434/v1 y SUMMARY_MODEL=<tu modelo>

# Contraseña de la página de prospectos (/admin). Sin ella, solo se abre desde esta computadora.
ADMIN_PASSWORD=

# Tu panel (redes.kuper.media) recibe cada prospecto aquí con un POST JSON.
PANEL_WEBHOOK_URL=
PANEL_WEBHOOK_SECRET=

# Opcional: solo para voces privadas/clonadas de ElevenLabs o Cartesia
ELEVENLABS_API_KEY=
CARTESIA_API_KEY=
