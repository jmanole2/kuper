# Copia este archivo a .env y llena los valores.

PORT=3000
# Clave secreta de Retell (Settings -> API Keys). Se queda en el servidor.
RETELL_API_KEY=
# Opcional: ID del agente. Si va vacío, se busca por "nombre_agente" de negocio.json.
RETELL_AGENT_ID=

# Opcional: clave para el enlace de prueba (https://dominio/?c=CLAVE). Vacío = página abierta.
DEMO_CLAVE=
# Topes de pruebas al día (se reinician a medianoche UTC).
LLAMADAS_POR_IP_DIA=5
LLAMADAS_DIA_TOTAL=60

# Opcional: mandar cada llamada al panel de Kuper (queda como lead con resumen y transcripción).
# La llave es la "llave de la API" del cliente en el panel (pestaña Configuración).
PANEL_URL=https://redes.kuper.media
PANEL_SLUG=
PANEL_API_KEY=

# Opcional: que Sofía pueda buscar, cambiar y cancelar citas ya agendadas en Cal.com.
# CAL_API_KEY: Cal.com -> Settings -> Developer -> API keys (empieza con cal_). PUBLIC_URL: el dominio de esta página.
CAL_API_KEY=
PUBLIC_URL=https://llamadas.kuper.media

# Agente de ventas (Mateo, llama a empresas). Se crea solo con "crear" si negocio.json tiene "ventas".
# VENTAS_CLAVE: para probarlo desde la página: https://dominio/?ventas=CLAVE&empresa=Clínica Sonrisa&giro=dentista
VENTAS_CLAVE=
# Número comprado en Retell desde el que marca. Sin número solo se puede probar desde la página.
RETELL_FROM_NUMBER=
