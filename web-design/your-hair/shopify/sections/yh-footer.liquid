{% render 'yh-head' %}
{%- liquid
  assign st = section.settings
  assign words = st.logo_words | split: ' '
-%}
<footer class="yh yh-foot" style="--yh-ft-bg:{{ st.bg }};--yh-ft-tx:{{ st.text }};--yh-ft-mut:{{ st.text | color_modify: 'alpha', 0.6 }};--yh-ft-line:{{ st.text | color_modify: 'alpha', 0.16 }}">
  <div class="yh-wrap">
    <div class="yh-foot__top">
      <div class="yh-foot__brand">
        <a class="yh-logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }}" style="--yh-logo-bg:{{ st.text }};--yh-logo-tx:{{ st.bg }};--yh-logo:64px">
          {%- if st.logo != blank -%}{{ st.logo | image_url: width: 200 | image_tag: alt: shop.name }}{%- else -%}{%- for w in words -%}<span>{{ w }}</span>{%- endfor -%}{%- endif -%}
        </a>
        {%- if st.tagline != blank -%}<p>{{ st.tagline }}</p>{%- endif -%}
      </div>

      {%- for i in (1..3) -%}
        {%- liquid
          assign mk = 'menu_' | append: i
          assign tk = 'menu_' | append: i | append: '_title'
          assign menu = st[mk]
        -%}
        {%- if menu != blank and menu.links.size > 0 -%}
          <nav class="yh-foot__col" aria-label="{{ st[tk] | default: menu.title | escape }}">
            <h3>{{ st[tk] | default: menu.title }}</h3>
            <ul>{%- for link in menu.links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}</ul>
          </nav>
        {%- endif -%}
      {%- endfor -%}

      {%- if st.show_news -%}
        <div class="yh-foot__news">
          <h3>{{ st.news_title }}</h3>
          {%- if st.news_text != blank -%}<p>{{ st.news_text }}</p>{%- endif -%}
          {%- form 'customer', id: 'yh-foot-news' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            {%- if form.posted_successfully? -%}
              <p class="yh-foot__ok">¡Listo! Ya estás en la lista.</p>
            {%- else -%}
              <div class="yh-foot__field">
                <input type="email" name="contact[email]" placeholder="Tu correo" aria-label="Tu correo" required>
                <button type="submit" aria-label="Suscribirme">{% render 'yh-icon', icon: 'arrow' %}</button>
              </div>
            {%- endif -%}
          {%- endform -%}
        </div>
      {%- endif -%}
    </div>

    {%- if st.big_word -%}
      <div class="yh-foot__word" aria-hidden="true">{{ st.logo_words }}</div>
    {%- endif -%}

    <div class="yh-foot__bot">
      <span>© {{ 'now' | date: '%Y' }} {{ st.copyright | default: shop.name }}</span>
      <div class="yh-foot__social">
        {%- if st.instagram != blank -%}<a href="{{ st.instagram }}" target="_blank" rel="noopener">Instagram</a>{%- endif -%}
        {%- if st.tiktok != blank -%}<a href="{{ st.tiktok }}" target="_blank" rel="noopener">TikTok</a>{%- endif -%}
        {%- if st.facebook != blank -%}<a href="{{ st.facebook }}" target="_blank" rel="noopener">Facebook</a>{%- endif -%}
      </div>
      {%- if st.show_payments -%}
        <ul class="yh-foot__pay" aria-label="Métodos de pago">
          {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag }}</li>{%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "YH · Footer",
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    { "type": "color", "id": "bg", "label": "Fondo", "default": "#1F2914" },
    { "type": "color", "id": "text", "label": "Texto", "default": "#F7F0E7" },
    { "type": "image_picker", "id": "logo", "label": "Logo (opcional)" },
    { "type": "text", "id": "logo_words", "label": "Texto del logo", "default": "your hair" },
    { "type": "text", "id": "tagline", "label": "Frase", "default": "Shampoo y acondicionador sólido para cada tipo de cabello." },
    { "type": "header", "content": "Menús" },
    { "type": "text", "id": "menu_1_title", "label": "Columna 1 · título", "default": "Tienda" },
    { "type": "link_list", "id": "menu_1", "label": "Columna 1 · menú" },
    { "type": "text", "id": "menu_2_title", "label": "Columna 2 · título", "default": "your hair" },
    { "type": "link_list", "id": "menu_2", "label": "Columna 2 · menú" },
    { "type": "text", "id": "menu_3_title", "label": "Columna 3 · título", "default": "Ayuda" },
    { "type": "link_list", "id": "menu_3", "label": "Columna 3 · menú", "default": "footer" },
    { "type": "header", "content": "Newsletter" },
    { "type": "checkbox", "id": "show_news", "label": "Mostrar newsletter", "default": true },
    { "type": "text", "id": "news_title", "label": "Título", "default": "10% en tu primera barra" },
    { "type": "text", "id": "news_text", "label": "Texto", "default": "Rutinas por tipo de cabello y lanzamientos." },
    { "type": "header", "content": "Abajo" },
    { "type": "checkbox", "id": "big_word", "label": "Mostrar nombre grande", "default": true },
    { "type": "text", "id": "copyright", "label": "Nombre en el copyright", "default": "your hair" },
    { "type": "url", "id": "instagram", "label": "Instagram" },
    { "type": "url", "id": "tiktok", "label": "TikTok" },
    { "type": "url", "id": "facebook", "label": "Facebook" },
    { "type": "checkbox", "id": "show_payments", "label": "Mostrar métodos de pago", "default": true }
  ],
  "presets": [{ "name": "YH · Footer" }]
}
{% endschema %}
