{% render 'yh-head' %}
{% render 'yh-section-style', section: section %}
{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign tile = product.metafields.custom.bg_color.value | default: section.settings.tile_bg
  assign short = product.metafields.custom.short_description.value
  if short == blank
    assign short = product.description | strip_html | truncatewords: 28
  endif
-%}
<section class="yh yh-pdp{% if section.settings.img_shadow %} yh-pdp--shadow{% endif %}{% if section.settings.blend %} yh-blend{% endif %}" id="yh-{{ section.id }}" data-yh-pdp>
  <div class="yh-wrap">
    {%- if section.settings.show_crumbs -%}
    <nav class="yh-crumbs" aria-label="Migas">
      <a href="{{ routes.root_url }}">Inicio</a> / {% if collection %}<a href="{{ collection.url }}">{{ collection.title }}</a> / {% endif %}<span>{{ product.title }}</span>
    </nav>
    {%- endif -%}

    <div class="yh-pdp__grid">
      {%- comment -%} Left column: name, rating, short description, attributes {%- endcomment -%}
      <div class="yh-pdp__info">
        {%- if product.type != blank -%}<div class="yh-kicker">{{ product.type }}</div>{%- endif -%}
        <h1 class="yh-title">{{ product.title }}</h1>
        {%- assign rating = product.metafields.reviews.rating.value -%}
        {%- if rating != blank or section.settings.rating_text != blank -%}
          <a class="yh-pdp__rating" href="#yh-reviews">
            <span class="st">{%- for s in (1..5) -%}{% render 'yh-icon', icon: 'star' %}{%- endfor -%}</span>
            {%- if rating != blank -%}{{ rating.rating | round: 1 }} · {{ product.metafields.reviews.rating_count }} reseñas{%- else -%}{{ section.settings.rating_text }}{%- endif -%}
          </a>
        {%- endif -%}
        <p class="yh-pdp__short">{{ short }}</p>
        <dl class="yh-pdp__attrs">
          {%- for block in section.blocks -%}
            {%- if block.type == 'attribute' -%}
              {%- liquid
                assign val = block.settings.value
                if block.settings.metafield != blank
                  assign parts = block.settings.metafield | split: '.'
                  assign mf = product.metafields[parts[0]][parts[1]].value
                  if mf != blank
                    assign val = mf
                  endif
                endif
              -%}
              {%- if val != blank -%}<div {{ block.shopify_attributes }}><dt>{{ block.settings.label }}</dt><dd>{{ val }}</dd></div>{%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        </dl>
      </div>

      {%- comment -%} Center column: gallery {%- endcomment -%}
      <div class="yh-pdp__media">
        <div class="yh-pdp__stage" style="background:{{ tile }}">
          <div class="yh-pdp__slides" data-yh-slides>
            {%- for media in product.media -%}
              <div class="yh-pdp__slide{% if forloop.first %} is-on{% endif %}">
                {%- if media.media_type == 'image' -%}
                  {{ media | image_url: width: 1200 | image_tag: loading: 'eager', widths: '400, 700, 1000, 1200', sizes: '(max-width: 760px) 90vw, 40vw', alt: media.alt | default: product.title }}
                {%- elsif media.media_type == 'video' -%}
                  {{ media | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true }}
                {%- else -%}
                  {{ media | media_tag }}
                {%- endif -%}
              </div>
            {%- else -%}
              <div class="yh-pdp__slide is-on">{{ 'product-1' | placeholder_svg_tag }}</div>
            {%- endfor -%}
          </div>
          {%- if product.media.size > 1 -%}
            <button type="button" class="yh-pdp__nav yh-pdp__nav--prev" data-yh-prev aria-label="Foto anterior"><svg viewBox="0 0 24 24"><path d="M15 4l-8 8 8 8" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
            <button type="button" class="yh-pdp__nav yh-pdp__nav--next" data-yh-next aria-label="Foto siguiente"><svg viewBox="0 0 24 24"><path d="M9 4l8 8-8 8" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
          {%- endif -%}
        </div>
        {%- if product.media.size > 1 -%}
          <div class="yh-pdp__dots">{%- for media in product.media -%}<button type="button" data-yh-dot="{{ forloop.index0 }}" class="{% if forloop.first %}is-on{% endif %}" aria-label="Foto {{ forloop.index }}"></button>{%- endfor -%}</div>
        {%- endif -%}
      </div>

      {%- comment -%} Right column: price, variants, quantity, add to cart, accordions {%- endcomment -%}
      <div class="yh-pdp__buy">
        <div class="yh-pdp__price">
          <span data-yh-price>{{ current_variant.price | money }}</span>
          {%- if current_variant.compare_at_price > current_variant.price -%}<s data-yh-compare>{{ current_variant.compare_at_price | money }}</s>{%- endif -%}
        </div>
        {%- if section.settings.price_note != blank -%}<div class="yh-pdp__note">{{ section.settings.price_note }}</div>{%- endif -%}

        {%- assign form_id = 'yh-form-' | append: section.id -%}
        {%- form 'product', product, id: form_id, class: 'yh-pdp__form' -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-yh-variant-id>
          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
              <fieldset class="yh-pdp__opt">
                <legend>{{ option.name }}</legend>
                <div>
                  {%- for value in option.values -%}
                    <label><input type="radio" name="yh-opt-{{ forloop.parentloop.index0 }}" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %} data-yh-opt="{{ forloop.parentloop.index0 }}"><span>{{ value }}</span></label>
                  {%- endfor -%}
                </div>
              </fieldset>
            {%- endfor -%}
          {%- endunless -%}
          <div class="yh-pdp__row">
            <div class="yh-qty">
              <button type="button" data-yh-qty="-1" aria-label="Menos">−</button>
              <input type="number" name="quantity" value="1" min="1" aria-label="Cantidad" data-yh-qty-input>
              <button type="button" data-yh-qty="1" aria-label="Más">+</button>
            </div>
            <button type="submit" class="yh-btn yh-pdp__atc" data-yh-atc {% unless current_variant.available %}disabled{% endunless %}>
              <span data-yh-atc-label>{% if current_variant.available %}Agregar al carrito{% else %}Agotado{% endif %}</span>
            </button>
          </div>
        {%- endform -%}
        <div class="yh-pdp__msg" data-yh-msg hidden>Agregado al carrito · <a href="{{ routes.cart_url }}">Ver carrito</a> · <a href="/checkout">Pagar</a></div>

        {%- if section.settings.perks != blank -%}
          <ul class="yh-pdp__perks">
            {%- assign perks = section.settings.perks | split: '|' -%}
            {%- for p in perks -%}<li>{{ p | strip }}</li>{%- endfor -%}
          </ul>
        {%- endif -%}

        <div class="yh-pdp__acc">
          {%- for block in section.blocks -%}
            {%- if block.type == 'accordion' -%}
              {%- liquid
                assign body = block.settings.content
                case block.settings.source
                  when 'description'
                    assign body = product.description
                  when 'metafield'
                    assign parts = block.settings.metafield | split: '.'
                    assign mf = product.metafields[parts[0]][parts[1]]
                    if mf.type == 'rich_text_field'
                      assign body = mf | metafield_tag
                    elsif mf.value != blank
                      assign body = mf.value | newline_to_br
                    endif
                endcase
              -%}
              {%- if body != blank -%}
                <details {{ block.shopify_attributes }} {% if block.settings.open %}open{% endif %}>
                  <summary>{{ block.settings.title }}<i aria-hidden="true"></i></summary>
                  <div class="rte">{{ body }}</div>
                </details>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>

  {%- if section.settings.sticky -%}
    <div class="yh-sticky" data-yh-sticky aria-hidden="true">
      <span class="yh-sticky__img" style="background:{{ tile }}">{%- if product.featured_image -%}{{ product.featured_image | image_url: width: 120 | image_tag: alt: '' }}{%- endif -%}</span>
      <span class="yh-sticky__name">{{ product.title }}</span>
      <span class="yh-sticky__price" data-yh-price>{{ current_variant.price | money }}</span>
      <button type="submit" form="yh-form-{{ section.id }}" class="yh-btn" data-yh-atc {% unless current_variant.available %}disabled{% endunless %}>
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3.5 6.5h13l-1 11h-11z M7 6.5V5a3 3 0 016 0v1.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
        <span data-yh-atc-label>{% if current_variant.available %}Agregar al carrito{% else %}Agotado{% endif %}</span>
      </button>
    </div>
  {%- endif -%}

  <script type="application/json" data-yh-variants>{{ product.variants | json }}</script>
</section>

<script>
(() => {
  const root = document.getElementById('yh-{{ section.id }}');
  if (!root || root.dataset.yhReady) return;
  root.dataset.yhReady = '1';
  const money = c => (c / 100).toLocaleString('es-MX', { style: 'currency', currency: {{ cart.currency.iso_code | json }} });

  // gallery
  const slides = [...root.querySelectorAll('.yh-pdp__slide')], dots = [...root.querySelectorAll('[data-yh-dot]')];
  let i = 0;
  const go = n => { i = (n + slides.length) % slides.length; slides.forEach((s, k) => s.classList.toggle('is-on', k === i)); dots.forEach((d, k) => d.classList.toggle('is-on', k === i)); };
  root.querySelector('[data-yh-prev]')?.addEventListener('click', () => go(i - 1));
  root.querySelector('[data-yh-next]')?.addEventListener('click', () => go(i + 1));
  dots.forEach(d => d.addEventListener('click', () => go(+d.dataset.yhDot)));

  // quantity
  const qty = root.querySelector('[data-yh-qty-input]');
  root.querySelectorAll('[data-yh-qty]').forEach(b => b.addEventListener('click', () => { qty.value = Math.max(1, (+qty.value || 1) + +b.dataset.yhQty); }));

  // variants
  const variants = JSON.parse(root.querySelector('[data-yh-variants]').textContent);
  const idInput = root.querySelector('[data-yh-variant-id]');
  const atcs = root.querySelectorAll('[data-yh-atc]'), labels = root.querySelectorAll('[data-yh-atc-label]');
  root.querySelectorAll('[data-yh-opt]').forEach(r => r.addEventListener('change', () => {
    const chosen = [...root.querySelectorAll('.yh-pdp__opt')].map(f => f.querySelector('input:checked')?.value);
    const v = variants.find(v => v.options.every((o, k) => o === chosen[k]));
    if (!v) return;
    idInput.value = v.id;
    root.querySelectorAll('[data-yh-price]').forEach(p => p.textContent = money(v.price));
    atcs.forEach(b => b.disabled = !v.available);
    labels.forEach(l => l.textContent = v.available ? 'Agregar al carrito' : 'Agotado');
    const u = new URL(location.href); u.searchParams.set('variant', v.id); history.replaceState(null, '', u);
  }));

  // add to cart without leaving the page
  const form = root.querySelector('.yh-pdp__form'), msg = root.querySelector('[data-yh-msg]');
  form.addEventListener('submit', async e => {
    e.preventDefault();
    atcs.forEach(b => b.disabled = true);
    try {
      const r = await fetch({{ routes.cart_add_url | append: '.js' | json }}, { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify({ id: +idInput.value, quantity: +qty.value || 1 }) });
      if (!r.ok) throw new Error((await r.json()).description || 'Error');
      const cart = await (await fetch({{ routes.cart_url | append: '.js' | json }})).json();
      document.querySelectorAll('.yh-cart').forEach(c => { let b = c.querySelector('b'); if (!b) { b = document.createElement('b'); c.appendChild(b); } b.textContent = cart.item_count; });
      document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
      if ({{ section.settings.after_add | json }} === 'cart') { location.href = {{ routes.cart_url | json }}; return; }
      labels.forEach(l => l.textContent = 'Agregado ✓');
      msg.hidden = false;
      setTimeout(() => labels.forEach(l => l.textContent = 'Agregar al carrito'), 2200);
    } catch (err) {
      msg.hidden = false; msg.textContent = err.message;
    } finally {
      atcs.forEach(b => b.disabled = false);
    }
  });

  // sticky add-to-cart: shows once the main button scrolls out of view
  const sticky = root.querySelector('[data-yh-sticky]'), main = root.querySelector('.yh-pdp__atc');
  if (sticky && main && 'IntersectionObserver' in window) {
    new IntersectionObserver(([en]) => {
      const show = !en.isIntersecting && en.boundingClientRect.top < 0;
      sticky.classList.toggle('is-on', show); sticky.setAttribute('aria-hidden', !show);
    }).observe(main);
  }
})();
</script>

{% schema %}
{
  "name": "YH · Producto",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "rating_text", "label": "Texto de calificación (si no hay app de reseñas)", "default": "4.9 · reseñas verificadas" },
    { "type": "text", "id": "price_note", "label": "Nota bajo el precio", "default": "Impuestos incluidos · Envío gratis desde $899" },
    { "type": "text", "id": "perks", "label": "Ventajas (separadas por |)", "default": "Color safe | pH balanceado | Sin botella de plástico" },
    { "type": "color", "id": "tile_bg", "label": "Fondo de la foto", "info": "Cada producto puede tener el suyo con el metafield custom.bg_color", "default": "#EFD9C6" },
    { "type": "checkbox", "id": "show_crumbs", "label": "Mostrar migas (Inicio / producto)", "default": false },
    { "type": "checkbox", "id": "blend", "label": "Fundir el fondo blanco de las fotos con el color", "default": true },
    { "type": "checkbox", "id": "img_shadow", "label": "Sombra en la foto", "info": "Solo para fotos PNG sin fondo.", "default": false },
    { "type": "checkbox", "id": "sticky", "label": "Barra flotante de agregar al carrito", "default": true },
    { "type": "select", "id": "after_add", "label": "Después de agregar", "default": "stay", "options": [
      { "value": "stay", "label": "Quedarse en la página" }, { "value": "cart", "label": "Ir al carrito" }
    ]},
    {"type": "header", "content": "Diseño"},
    {"type": "color", "id": "bg", "label": "Fondo", "default": "#F7F0E7"},
    {"type": "color", "id": "text_color", "label": "Color de los textos", "default": "#1F2914"},
    {"type": "color", "id": "accent", "label": "Color de acento", "default": "#E3A47E"},
    {"type": "color", "id": "btn_bg", "label": "Botón · fondo", "default": "#1F2914"},
    {"type": "color", "id": "btn_text", "label": "Botón · texto", "default": "#F7F0E7"},
    {"type": "select", "id": "title_font_mode", "label": "Fuente de títulos", "default": "serif", "options": [{"value": "serif", "label": "Serif de your hair"}, {"value": "sans", "label": "Sans de your hair"}, {"value": "custom", "label": "Elegir otra"}]},
    {"type": "font_picker", "id": "title_font", "label": "Otra fuente para títulos", "default": "playfair_display_n4"},
    {"type": "range", "id": "title_size", "label": "Tamaño de títulos", "min": 24, "max": 96, "step": 2, "default": 52, "unit": "px"},
    {"type": "checkbox", "id": "title_upper", "label": "Títulos en mayúsculas", "default": true},
    {"type": "select", "id": "body_font_mode", "label": "Fuente de textos", "default": "sans", "options": [{"value": "sans", "label": "Sans de your hair"}, {"value": "custom", "label": "Elegir otra"}]},
    {"type": "font_picker", "id": "body_font", "label": "Otra fuente para textos", "default": "assistant_n4"}
  ],
  "blocks": [
    { "type": "attribute", "name": "Dato del producto", "settings": [
      { "type": "text", "id": "label", "label": "Etiqueta", "default": "Para" },
      { "type": "text", "id": "value", "label": "Valor", "default": "Cabello seco" },
      { "type": "text", "id": "metafield", "label": "O leer de un metafield", "info": "Ejemplo: custom.hair_type. Si el producto lo tiene, reemplaza al valor." }
    ]},
    { "type": "accordion", "name": "Desplegable", "settings": [
      { "type": "text", "id": "title", "label": "Título", "default": "Modo de uso" },
      { "type": "select", "id": "source", "label": "Contenido", "default": "custom", "options": [
        { "value": "custom", "label": "Texto de abajo" }, { "value": "description", "label": "Descripción del producto" }, { "value": "metafield", "label": "Metafield" }
      ]},
      { "type": "richtext", "id": "content", "label": "Texto", "default": "<p>Frota la barra húmeda entre tus manos o directo sobre el cabello mojado.</p>" },
      { "type": "text", "id": "metafield", "label": "Metafield", "info": "Ejemplo: custom.ingredients" },
      { "type": "checkbox", "id": "open", "label": "Abierto al cargar", "default": false }
    ]}
  ]
}
{% endschema %}
