{% render 'yh-head' %}
{% render 'yh-section-style', section: section %}
<section class="yh yh-contact" id="yh-{{ section.id }}">
  <div class="yh-wrap yh-contact__grid">
    <div>
      {%- if section.settings.kicker != blank -%}<div class="yh-kicker">{{ section.settings.kicker }}</div>{%- endif -%}
      <h1 class="yh-title">{{ section.settings.heading }}</h1>
      {%- if section.settings.text != blank -%}<div class="rte yh-contact__intro">{{ section.settings.text }}</div>{%- endif -%}
      <ul class="yh-contact__ways">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            <span class="ic">{% render 'yh-icon', icon: block.settings.icon %}</span>
            <div>
              <b>{{ block.settings.title }}</b>
              {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ block.settings.text }}</a>{%- else -%}<span>{{ block.settings.text }}</span>{%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    </div>
    <div class="yh-contact__card">
      {%- form 'contact', class: 'yh-form' -%}
        {%- if form.posted_successfully? -%}
          <p class="yh-form__ok">{{ section.settings.success }}</p>
        {%- endif -%}
        {%- if form.errors -%}<div class="yh-form__err">{{ form.errors | default_errors }}</div>{%- endif -%}
        <label>Nombre<input type="text" name="contact[name]" autocomplete="name" required></label>
        <label>Correo<input type="email" name="contact[email]" autocomplete="email" required></label>
        <label>Teléfono (opcional)<input type="tel" name="contact[phone]" autocomplete="tel"></label>
        <label>¿En qué te ayudamos?
          <select name="contact[tema]">
            <option>Elegir mi barra</option><option>Mi pedido</option><option>Cambios y devoluciones</option><option>Mayoreo</option><option>Otro</option>
          </select>
        </label>
        <label>Mensaje<textarea name="contact[body]" rows="5" required></textarea></label>
        <button type="submit" class="yh-btn">{{ section.settings.button }} {% render 'yh-icon', icon: 'arrow' %}</button>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "YH · Contacto",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Texto pequeño", "default": "Contacto" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Hablemos de <em>tu cabello</em>" },
    { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Si no sabes qué barra elegir, cuéntanos cómo es tu cabello y te recomendamos tu rutina. Respondemos en menos de 24 horas hábiles.</p>" },
    { "type": "text", "id": "button", "label": "Botón", "default": "Enviar mensaje" },
    { "type": "text", "id": "success", "label": "Mensaje enviado", "default": "¡Gracias! Te respondemos muy pronto." },
    {"type": "header", "content": "Diseño"},
    {"type": "color", "id": "bg", "label": "Fondo", "default": "#F7F0E7"},
    {"type": "color", "id": "text_color", "label": "Color de los textos", "default": "#1F2914"},
    {"type": "color", "id": "accent", "label": "Color de acento", "default": "#E3A47E"},
    {"type": "color", "id": "btn_bg", "label": "Botón · fondo", "default": "#1F2914"},
    {"type": "color", "id": "btn_text", "label": "Botón · texto", "default": "#F7F0E7"},
    {"type": "select", "id": "title_font_mode", "label": "Fuente de títulos", "default": "serif", "options": [{"value": "serif", "label": "Serif de your hair"}, {"value": "sans", "label": "Sans de your hair"}, {"value": "custom", "label": "Elegir otra"}]},
    {"type": "font_picker", "id": "title_font", "label": "Otra fuente para títulos", "default": "playfair_display_n4"},
    {"type": "range", "id": "title_size", "label": "Tamaño de títulos", "min": 24, "max": 96, "step": 2, "default": 52, "unit": "px"},
    {"type": "checkbox", "id": "title_upper", "label": "Títulos en mayúsculas", "default": true},
    {"type": "select", "id": "body_font_mode", "label": "Fuente de textos", "default": "sans", "options": [{"value": "sans", "label": "Sans de your hair"}, {"value": "custom", "label": "Elegir otra"}]},
    {"type": "font_picker", "id": "body_font", "label": "Otra fuente para textos", "default": "assistant_n4"}
  ],
  "blocks": [
    { "type": "way", "name": "Dato de contacto", "settings": [
      { "type": "select", "id": "icon", "label": "Ícono", "default": "chat", "options": [
        { "value": "chat", "label": "WhatsApp / chat" }, { "value": "mail", "label": "Correo" }, { "value": "clock", "label": "Horario" }, { "value": "pin", "label": "Ubicación" }
      ]},
      { "type": "text", "id": "title", "label": "Título", "default": "WhatsApp" },
      { "type": "text", "id": "text", "label": "Texto", "default": "Escríbenos" },
      { "type": "url", "id": "link", "label": "Enlace", "info": "WhatsApp: https://wa.me/5219991234567 · Correo: mailto:hola@tudominio.com" }
    ]}
  ],
  "presets": [{ "name": "YH · Contacto" }]
}
{% endschema %}
