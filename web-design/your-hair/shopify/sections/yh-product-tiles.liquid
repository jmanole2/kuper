{% render 'yh-head' %}
<section class="yh yh-tiles" id="yh-{{ section.id }}" style="background:{{ section.settings.bg }}">
  <div class="yh-wrap">
    <div class="yh-sec-top">
      <div>
        {%- if section.settings.kicker != blank -%}<div class="yh-kicker">{{ section.settings.kicker }}</div>{%- endif -%}
        <h2 class="yh-title">{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.link_label != blank -%}<a class="yh-link" href="{{ section.settings.link | default: '#' }}">{{ section.settings.link_label }} {% render 'yh-icon', icon: 'arrow' %}</a>{%- endif -%}
    </div>

    <div class="yh-cards{% if section.blocks.size == 3 %} yh-cards--3{% endif %}" style="--yh-cols:{{ section.blocks.size }};--yh-ratio:{{ section.settings.ratio }}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign p = block.settings.product
          assign title = block.settings.title
          if title == blank and p != blank
            assign title = p.title
          endif
          assign url = '#'
          if p != blank
            assign url = p.url
          endif
          assign img = block.settings.image
          if img == blank and block.settings.fallback == blank and p != blank
            assign img = p.featured_media.preview_image
          endif
        -%}
        <div class="yh-card" {{ block.shopify_attributes }}>
          <a class="ph" href="{{ url }}" style="background:{{ block.settings.color }}">
            {%- if block.settings.badge != blank -%}<span class="badge">{{ block.settings.badge }}</span>{%- endif -%}
            <span class="yh-prod">{% render 'yh-img', image: img, fallback: block.settings.fallback, height: block.settings.height, alt: title %}</span>
          </a>
          {%- if p != blank and p.available -%}
            {%- form 'product', p -%}
              <input type="hidden" name="id" value="{{ p.selected_or_first_available_variant.id }}">
              <button type="submit" class="add" aria-label="Agregar {{ title | escape }} al carrito">{% render 'yh-icon', icon: 'plus' %}</button>
            {%- endform -%}
          {%- endif -%}
          <div class="nm">
            <a href="{{ url }}">{{ title }}</a>
            <span>{% if p != blank %}{{ p.price | money_without_trailing_zeros }}{% else %}{{ block.settings.price }}{% endif %}</span>
          </div>
          {%- if block.settings.subtitle != blank -%}<div class="sub">{{ block.settings.subtitle }}</div>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
<style>#yh-{{ section.id }} .yh-card{position:relative}#yh-{{ section.id }} .yh-card form{position:absolute;right:12px;top:12px}</style>

{% schema %}
{
  "name": "YH · Productos",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Texto pequeño", "default": "Tratamientos" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Completa tu rutina" },
    { "type": "text", "id": "link_label", "label": "Texto del enlace", "default": "Ver tratamientos" },
    { "type": "url", "id": "link", "label": "Enlace" },
    { "type": "select", "id": "ratio", "label": "Forma de la tarjeta", "default": "3/4", "options": [
      { "value": "3/4", "label": "Vertical" }, { "value": "1/1", "label": "Cuadrada" }, { "value": "4/3", "label": "Horizontal" }
    ]},
    { "type": "color", "id": "bg", "label": "Fondo", "default": "#F7F0E7" }
  ],
  "blocks": [
    { "type": "item", "name": "Producto", "settings": [
      { "type": "product", "id": "product", "label": "Producto de Shopify", "info": "Toma el nombre, el precio y el botón de agregar al carrito." },
      { "type": "image_picker", "id": "image", "label": "Imagen PNG sin fondo (opcional)" },
      { "type": "text", "id": "fallback", "label": "Imagen del tema (si no subes una)" },
      { "type": "range", "id": "height", "label": "Alto de la imagen (px)", "min": 80, "max": 320, "step": 5, "default": 210 },
      { "type": "color", "id": "color", "label": "Color de fondo", "default": "#F8D58A" },
      { "type": "text", "id": "badge", "label": "Etiqueta (Nuevo, Más vendido…)" },
      { "type": "text", "id": "title", "label": "Nombre (si no eliges producto)" },
      { "type": "text", "id": "subtitle", "label": "Descripción corta" },
      { "type": "text", "id": "price", "label": "Precio (si no eliges producto)" }
    ]}
  ],
  "max_blocks": 6,
  "presets": [{ "name": "YH · Productos" }]
}
{% endschema %}
