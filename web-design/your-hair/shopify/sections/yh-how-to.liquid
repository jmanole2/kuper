{% render 'yh-head' %}
{% render 'yh-section-style', section: section %}
<section class="yh yh-howto" id="yh-{{ section.id }}">
  <div class="yh-wrap">
    <div class="yh-howto__head">
      {%- if section.settings.kicker != blank -%}<div class="yh-kicker">{{ section.settings.kicker }}</div>{%- endif -%}
      <h2 class="yh-title">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div class="yh-howto__text rte">{{ section.settings.text }}</div>{%- endif -%}
    </div>
    <div class="yh-howto__grid">
      <div class="yh-howto__media" style="background:{{ section.settings.media_bg }}">
        {%- if section.settings.video != blank -%}
          {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, image_size: '1200x' }}
        {%- elsif section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600, 900, 1400' }}
        {%- elsif product.featured_image -%}
          {{ product.featured_image | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'is-product' }}
        {%- else -%}
          <img src="{{ 'yh-sh-02.png' | asset_url }}" alt="" class="is-product" width="400" height="400" loading="lazy">
        {%- endif -%}
      </div>
      <ol class="yh-howto__steps">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            <span class="ic">{% render 'yh-icon', icon: block.settings.icon %}</span>
            <div><b>{{ block.settings.title }}</b><span>{{ block.settings.text }}</span></div>
            <em>{{ forloop.index }}</em>
          </li>
        {%- endfor -%}
      </ol>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "YH · Así se usa",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Texto pequeño", "default": "Cómo se usa" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Así se usa. <em>Así rinde.</em>" },
    { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Treinta segundos en la regadera. Aquí tienes el paso a paso para tenerlo a la mano.</p>" },
    { "type": "video", "id": "video", "label": "Video (opcional)", "info": "Se reproduce en silencio y en bucle. Si no hay video se usa la imagen." },
    { "type": "image_picker", "id": "image", "label": "Imagen" },
    { "type": "color", "id": "media_bg", "label": "Fondo detrás del video", "default": "#EFD9C6" },
    {"type": "header", "content": "Diseño"},
    {"type": "color", "id": "bg", "label": "Fondo", "default": "#F7F0E7"},
    {"type": "color", "id": "text_color", "label": "Color de los textos", "default": "#1F2914"},
    {"type": "color", "id": "accent", "label": "Color de acento", "default": "#E3A47E"},
    {"type": "color", "id": "btn_bg", "label": "Botón · fondo", "default": "#1F2914"},
    {"type": "color", "id": "btn_text", "label": "Botón · texto", "default": "#F7F0E7"},
    {"type": "select", "id": "title_font_mode", "label": "Fuente de títulos", "default": "serif", "options": [{"value": "serif", "label": "Serif de your hair"}, {"value": "sans", "label": "Sans de your hair"}, {"value": "custom", "label": "Elegir otra"}]},
    {"type": "font_picker", "id": "title_font", "label": "Otra fuente para títulos", "default": "playfair_display_n4"},
    {"type": "range", "id": "title_size", "label": "Tamaño de títulos", "min": 24, "max": 96, "step": 2, "default": 52, "unit": "px"},
    {"type": "checkbox", "id": "title_upper", "label": "Títulos en mayúsculas", "default": true},
    {"type": "select", "id": "body_font_mode", "label": "Fuente de textos", "default": "sans", "options": [{"value": "sans", "label": "Sans de your hair"}, {"value": "custom", "label": "Elegir otra"}]},
    {"type": "font_picker", "id": "body_font", "label": "Otra fuente para textos", "default": "assistant_n4"}
  ],
  "blocks": [
    { "type": "step", "name": "Paso", "settings": [
      { "type": "select", "id": "icon", "label": "Ícono", "default": "drop", "options": [
        { "value": "drop", "label": "Gota" }, { "value": "faucet", "label": "Llave de agua" }, { "value": "waves", "label": "Espuma" }, { "value": "clock", "label": "Reloj" }, { "value": "dry", "label": "Barra secando" }, { "value": "leaf", "label": "Hoja" }, { "value": "heart", "label": "Corazón" }
      ]},
      { "type": "text", "id": "title", "label": "Título", "default": "Con el cabello mojado" },
      { "type": "textarea", "id": "text", "label": "Texto", "default": "Moja bien tu cabello antes de empezar." }
    ]}
  ],
  "max_blocks": 6,
  "presets": [{ "name": "YH · Así se usa" }]
}
{% endschema %}
