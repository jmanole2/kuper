{% render 'yh-head' %}
{% render 'yh-section-style', section: section %}
<section class="yh yh-phero{% if section.settings.image != blank %} yh-phero--img{% endif %}" id="yh-{{ section.id }}">
  <div class="yh-wrap yh-phero__in">
    <div class="yh-phero__txt">
      {%- if section.settings.kicker != blank -%}<div class="yh-kicker">{{ section.settings.kicker }}</div>{%- endif -%}
      <h1 class="yh-title">{{ section.settings.heading | default: page.title }}</h1>
      {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
    </div>
    {%- if section.settings.image != blank -%}
      <div class="yh-phero__img">{{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'eager', widths: '600, 1000, 1400' }}</div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "YH · Encabezado de página",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Texto pequeño", "default": "your hair" },
    { "type": "text", "id": "heading", "label": "Título", "info": "Si lo dejas vacío usa el título de la página." },
    { "type": "richtext", "id": "text", "label": "Texto" },
    { "type": "image_picker", "id": "image", "label": "Imagen (opcional)" },
    {"type": "header", "content": "Diseño"},
    {"type": "color", "id": "bg", "label": "Fondo", "default": "#F7F0E7"},
    {"type": "color", "id": "text_color", "label": "Color de los textos", "default": "#1F2914"},
    {"type": "color", "id": "accent", "label": "Color de acento", "default": "#E3A47E"},
    {"type": "color", "id": "btn_bg", "label": "Botón · fondo", "default": "#1F2914"},
    {"type": "color", "id": "btn_text", "label": "Botón · texto", "default": "#F7F0E7"},
    {"type": "select", "id": "title_font_mode", "label": "Fuente de títulos", "default": "serif", "options": [{"value": "serif", "label": "Serif de your hair"}, {"value": "sans", "label": "Sans de your hair"}, {"value": "custom", "label": "Elegir otra"}]},
    {"type": "font_picker", "id": "title_font", "label": "Otra fuente para títulos", "default": "playfair_display_n4"},
    {"type": "range", "id": "title_size", "label": "Tamaño de títulos", "min": 24, "max": 96, "step": 2, "default": 52, "unit": "px"},
    {"type": "checkbox", "id": "title_upper", "label": "Títulos en mayúsculas", "default": true},
    {"type": "select", "id": "body_font_mode", "label": "Fuente de textos", "default": "sans", "options": [{"value": "sans", "label": "Sans de your hair"}, {"value": "custom", "label": "Elegir otra"}]},
    {"type": "font_picker", "id": "body_font", "label": "Otra fuente para textos", "default": "assistant_n4"}
  ],
  "presets": [{ "name": "YH · Encabezado de página" }]
}
{% endschema %}
