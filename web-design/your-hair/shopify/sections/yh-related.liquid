{%- comment -%}
  "Te puede interesar": Shopify product recommendations, loaded with the Section Rendering API.
  Falls back to a chosen collection when there are no recommendations yet (new stores).
{%- endcomment -%}
{% render 'yh-head' %}
{% render 'yh-section-style', section: section %}
{%- liquid
  assign palette = '#F6C54C,#BEC58B,#B9AFD2,#F7864C,#F6DEC2,#F6B537,#9DDBB7' | split: ','
  assign items = recommendations.products
  if recommendations.performed? == false or items.size == 0
    assign items = section.settings.collection.products
  endif
-%}
<section class="yh yh-tiles yh-related" id="yh-{{ section.id }}"
  data-yh-rec="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}"
  data-yh-loaded="{% if recommendations.performed? %}1{% endif %}">
  <div class="yh-wrap">
    <div class="yh-sec-top">
      <div>
        {%- if section.settings.kicker != blank -%}<div class="yh-kicker">{{ section.settings.kicker }}</div>{%- endif -%}
        <h2 class="yh-title">{{ section.settings.heading }}</h2>
      </div>
    </div>
    <div class="yh-cards" style="--yh-cols:{{ section.settings.limit }}">
      {%- assign n = 0 -%}
      {%- for p in items -%}
        {%- if p.id == product.id -%}{%- continue -%}{%- endif -%}
        {%- if n >= section.settings.limit -%}{%- break -%}{%- endif -%}
        {%- liquid
          assign idx = n | modulo: palette.size
          assign bg = p.metafields.custom.bg_color.value | default: palette[idx]
          assign n = n | plus: 1
        -%}
        <div class="yh-card">
          <a class="ph" href="{{ p.url }}" style="background:{{ bg }}">
            <span class="yh-prod">{%- if p.featured_image -%}{{ p.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: p.title, style: 'height:200px' }}{%- endif -%}</span>
          </a>
          {%- if p.available -%}
            {%- form 'product', p -%}
              <input type="hidden" name="id" value="{{ p.selected_or_first_available_variant.id }}">
              <button type="submit" class="add" aria-label="Agregar {{ p.title | escape }}">{% render 'yh-icon', icon: 'plus' %}</button>
            {%- endform -%}
          {%- endif -%}
          <div class="nm"><a href="{{ p.url }}">{{ p.title }}</a><span>{{ p.price | money_without_trailing_zeros }}</span></div>
          {%- if p.type != blank -%}<div class="sub">{{ p.type }}</div>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
<style>#yh-{{ section.id }} .yh-card{position:relative}#yh-{{ section.id }} .yh-card form{position:absolute;right:12px;top:12px}</style>
<script>
(() => {
  const el = document.getElementById('yh-{{ section.id }}');
  if (!el || el.dataset.yhLoaded) return;
  fetch(el.dataset.yhRec).then(r => r.text()).then(html => {
    const fresh = new DOMParser().parseFromString(html, 'text/html').getElementById(el.id);
    if (fresh && fresh.querySelectorAll('.yh-card').length) el.innerHTML = fresh.innerHTML;
  }).catch(() => {});
})();
</script>

{% schema %}
{
  "name": "YH · Te puede interesar",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Texto pequeño", "default": "Completa tu rutina" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Te puede interesar" },
    { "type": "range", "id": "limit", "label": "Productos", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "collection", "id": "collection", "label": "Colección de respaldo", "info": "Se muestra mientras Shopify aún no tiene recomendaciones." },
    {"type": "header", "content": "Diseño"},
    {"type": "color", "id": "bg", "label": "Fondo", "default": "#F7F0E7"},
    {"type": "color", "id": "text_color", "label": "Color de los textos", "default": "#1F2914"},
    {"type": "color", "id": "accent", "label": "Color de acento", "default": "#E3A47E"},
    {"type": "color", "id": "btn_bg", "label": "Botón · fondo", "default": "#1F2914"},
    {"type": "color", "id": "btn_text", "label": "Botón · texto", "default": "#F7F0E7"},
    {"type": "select", "id": "title_font_mode", "label": "Fuente de títulos", "default": "serif", "options": [{"value": "serif", "label": "Serif de your hair"}, {"value": "sans", "label": "Sans de your hair"}, {"value": "custom", "label": "Elegir otra"}]},
    {"type": "font_picker", "id": "title_font", "label": "Otra fuente para títulos", "default": "playfair_display_n4"},
    {"type": "range", "id": "title_size", "label": "Tamaño de títulos", "min": 24, "max": 96, "step": 2, "default": 52, "unit": "px"},
    {"type": "checkbox", "id": "title_upper", "label": "Títulos en mayúsculas", "default": true},
    {"type": "select", "id": "body_font_mode", "label": "Fuente de textos", "default": "sans", "options": [{"value": "sans", "label": "Sans de your hair"}, {"value": "custom", "label": "Elegir otra"}]},
    {"type": "font_picker", "id": "body_font", "label": "Otra fuente para textos", "default": "assistant_n4"}
  ],
  "presets": [{ "name": "YH · Te puede interesar" }]
}
{% endschema %}
