{% render 'yh-head' %}
<section class="yh yh-compare" id="yh-{{ section.id }}" style="background:{{ section.settings.bg }}">
  <div class="yh-wrap">
    <div class="yh-cmp">
      <div class="yh-cmp__vis">
        {%- for i in (1..3) -%}
          {%- liquid
            assign key = 'image_' | append: i
            assign fkey = 'fallback_' | append: i
          -%}
          {% render 'yh-img', image: section.settings[key], fallback: section.settings[fkey], height: 'auto', alt: '' %}
        {%- endfor -%}
      </div>
      <div>
        {%- if section.settings.kicker != blank -%}<div class="yh-kicker">{{ section.settings.kicker }}</div>{%- endif -%}
        <h2 class="yh-title">{{ section.settings.heading }}</h2>
        <table>
          <tr><th></th><th class="us">{{ section.settings.col_us }}</th><th>{{ section.settings.col_them }}</th></tr>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}><td>{{ block.settings.label }}</td><td class="us">{{ block.settings.us }}</td><td class="them">{{ block.settings.them }}</td></tr>
          {%- endfor -%}
        </table>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "YH · Barra vs. botella",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Texto pequeño", "default": "Barra vs. botella" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Lo que cambia cuando tu shampoo <em>no viene en botella</em>" },
    { "type": "text", "id": "col_us", "label": "Columna 1", "default": "your hair" },
    { "type": "text", "id": "col_them", "label": "Columna 2", "default": "Shampoo en botella" },
    { "type": "image_picker", "id": "image_1", "label": "Imagen 1" },
    { "type": "text", "id": "fallback_1", "label": "Imagen 1 del tema", "default": "yh-sh-07.png" },
    { "type": "image_picker", "id": "image_2", "label": "Imagen 2" },
    { "type": "text", "id": "fallback_2", "label": "Imagen 2 del tema", "default": "yh-co-02.png" },
    { "type": "image_picker", "id": "image_3", "label": "Imagen 3" },
    { "type": "text", "id": "fallback_3", "label": "Imagen 3 del tema", "default": "yh-sh-04.png" },
    { "type": "color", "id": "bg", "label": "Fondo", "default": "#F7F0E7" }
  ],
  "blocks": [
    { "type": "row", "name": "Fila", "settings": [
      { "type": "text", "id": "label", "label": "Concepto", "default": "Fórmula" },
      { "type": "text", "id": "us", "label": "your hair", "default": "Concentrada, sin agua añadida" },
      { "type": "text", "id": "them", "label": "Botella", "default": "Diluida en agua" }
    ]}
  ],
  "max_blocks": 8,
  "presets": [{ "name": "YH · Barra vs. botella" }]
}
{% endschema %}
