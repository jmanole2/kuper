{% render 'yh-head' %}
<section class="yh yh-hero" id="yh-{{ section.id }}"
  style="--yh-wall:{{ section.settings.wall_color }};--yh-floor:{{ section.settings.floor_color }};--yh-accent:{{ section.settings.accent_color }};--yh-hero-h:{{ section.settings.height }}px;--yh-text:{{ section.settings.text_color }};--yh-b1bg:{{ section.settings.btn1_bg }};--yh-b1tx:{{ section.settings.btn1_text }}">
  <div class="yh-hero__sun"></div>
  <span class="yh-hero__leaf" style="fill:#0E1409">{% render 'yh-icon', icon: 'leaves' %}</span>
  <span class="yh-hero__leaf yh-hero__leaf--l" style="fill:#0E1409">{% render 'yh-icon', icon: 'leaves' %}</span>

  <div class="yh-hero__copy">
    {%- if section.settings.kicker != blank -%}<div class="yh-kicker">{{ section.settings.kicker }}</div>{%- endif -%}
    <h1 class="yh-title">{{ section.settings.heading }}</h1>
    {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    <div class="yh-hero__ctas">
      {%- if section.settings.btn1_label != blank -%}
        <a class="yh-btn yh-btn--light" href="{{ section.settings.btn1_link | default: '#' }}">{{ section.settings.btn1_label }} {% render 'yh-icon', icon: 'arrow' %}</a>
      {%- endif -%}
      {%- if section.settings.btn2_label != blank -%}
        <a class="yh-btn yh-btn--ghost" href="{{ section.settings.btn2_link | default: '#' }}">{{ section.settings.btn2_label }}</a>
      {%- endif -%}
    </div>
    {%- if section.settings.show_swatches -%}
      <div class="yh-swatches">
        {%- assign swatches = section.settings.swatches | split: ',' -%}
        {%- for c in swatches -%}<i style="background:{{ c | strip }}"></i>{%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  <div class="yh-hero__floor"></div>
  <div class="yh-hero__line">
    {%- for block in section.blocks -%}
      {%- if block.type == 'product' -%}
        <div class="yh-prod" {{ block.shopify_attributes }}>{% render 'yh-img', image: block.settings.image, fallback: block.settings.fallback, height: block.settings.height, alt: block.settings.alt %}</div>
      {%- endif -%}
    {%- endfor -%}
  </div>
  <div class="yh-hero__front">
    {%- for block in section.blocks -%}
      {%- if block.type == 'front' -%}
        <div class="yh-prod" {{ block.shopify_attributes }}>{% render 'yh-img', image: block.settings.image, fallback: block.settings.fallback, height: block.settings.height, alt: block.settings.alt %}</div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "YH · Hero con productos",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Texto pequeño", "default": "Shampoo y acondicionador sólido" },
    { "type": "text", "id": "heading", "label": "Título", "info": "Usa <em>palabra</em> para ponerla en itálica y color.", "default": "Tu cabello tiene<br>su <em>fórmula</em>" },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Siete barras, cada una hecha para un tipo de cabello. Elige la tuya en un minuto." },
    { "type": "text", "id": "btn1_label", "label": "Botón 1", "default": "Encuentra tu barra" },
    { "type": "url", "id": "btn1_link", "label": "Enlace botón 1" },
    { "type": "text", "id": "btn2_label", "label": "Botón 2", "default": "Ver tienda" },
    { "type": "url", "id": "btn2_link", "label": "Enlace botón 2" },
    { "type": "checkbox", "id": "show_swatches", "label": "Mostrar puntos de colores", "default": true },
    { "type": "text", "id": "swatches", "label": "Colores de los puntos (separados por coma)", "default": "#F6C54C,#BEC58B,#B9AFD2,#F7864C,#F6DEC2,#F6B537,#9DDBB7" },
    { "type": "color", "id": "wall_color", "label": "Color de pared", "default": "#1F2914" },
    { "type": "color", "id": "floor_color", "label": "Color de piso", "default": "#EAC7AA" },
    { "type": "color", "id": "accent_color", "label": "Color de acento (palabra en itálica)", "default": "#F6C54C" },
    { "type": "color", "id": "text_color", "label": "Color de los textos", "default": "#F7F0E7" },
    { "type": "color", "id": "btn1_bg", "label": "Botón 1 · fondo", "default": "#F7F0E7" },
    { "type": "color", "id": "btn1_text", "label": "Botón 1 · texto", "default": "#1F2914" },
    { "type": "range", "id": "height", "label": "Alto (px)", "min": 600, "max": 1000, "step": 20, "default": 860 }
  ],
  "blocks": [
    {
      "type": "product", "name": "Producto (fila de atrás)", "limit": 7,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagen PNG sin fondo" },
        { "type": "text", "id": "fallback", "label": "Imagen del tema (si no subes una)", "info": "Nombre de archivo en Assets, p. ej. yh-suero.png" },
        { "type": "text", "id": "alt", "label": "Texto alternativo" },
        { "type": "range", "id": "height", "label": "Alto (px)", "min": 60, "max": 360, "step": 5, "default": 220 }
      ]
    },
    {
      "type": "front", "name": "Barra (al frente)", "limit": 3,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagen PNG sin fondo" },
        { "type": "text", "id": "fallback", "label": "Imagen del tema (si no subes una)" },
        { "type": "text", "id": "alt", "label": "Texto alternativo" },
        { "type": "range", "id": "height", "label": "Alto (px)", "min": 40, "max": 200, "step": 2, "default": 106 }
      ]
    }
  ],
  "presets": [{ "name": "YH · Hero con productos" }]
}
{% endschema %}
