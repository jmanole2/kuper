{% render 'yh-head' %}
{%- if section.settings.phone != blank -%}
  {%- assign phone = section.settings.phone | remove: ' ' | remove: '+' | remove: '-' | remove: '(' | remove: ')' -%}
  <div class="yh">
    <a class="yh-wa" href="https://wa.me/{{ phone }}{% if section.settings.message != blank %}?text={{ section.settings.message | url_encode }}{% endif %}" target="_blank" rel="noopener" aria-label="WhatsApp">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.5 14.4c-.3-.1-1.8-.9-2-1s-.5-.1-.7.1-.8 1-.9 1.2-.3.2-.6.1a8.2 8.2 0 01-2.4-1.5 9 9 0 01-1.7-2.1c-.2-.3 0-.5.1-.6l.4-.5.3-.5a.5.5 0 000-.5c-.1-.1-.7-1.6-.9-2.2s-.5-.5-.7-.5h-.6a1.1 1.1 0 00-.8.4 3.4 3.4 0 00-1 2.5 5.9 5.9 0 001.2 3.1 13.4 13.4 0 005.2 4.6c.7.3 1.3.5 1.7.6a4.2 4.2 0 001.9.1 3.1 3.1 0 002-1.4 2.5 2.5 0 00.2-1.4c-.1-.2-.3-.3-.6-.4zM12 21.8a9.9 9.9 0 01-5-1.4l-.4-.2-3.7 1 1-3.6-.2-.4a9.9 9.9 0 1118.2-5.3A9.9 9.9 0 0112 21.8zm8.4-18.3A11.8 11.8 0 001.8 17.7L.1 24l6.4-1.7a11.8 11.8 0 005.6 1.4A11.8 11.8 0 0020.4 3.5z"/></svg>
    </a>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "YH · Botón de WhatsApp",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "phone", "label": "Número con lada", "info": "Ejemplo: 5219991234567" },
    { "type": "text", "id": "message", "label": "Mensaje inicial", "default": "Hola, quiero ayuda para elegir mi barra." }
  ],
  "presets": [{ "name": "YH · Botón de WhatsApp" }]
}
{% endschema %}
