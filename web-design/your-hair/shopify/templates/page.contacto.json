      "blocks": {
        "faq-0": {
          "type": "qa",
          "settings": {
            "q": "¿Cuál barra es para mí?",
            "a": "<p>Busca tu tipo de cabello en <a href=\"/#encuentra-tu-barra\">Encuentra tu barra</a>. Si tienes raíz grasa y puntas secas, usa el shampoo de tu raíz y el acondicionador de tus puntas.</p>"
          }
        },
        "faq-1": {
          "type": "qa",
          "settings": {
            "q": "¿Cuánto dura una barra?",
            "a": "<p>Con uso regular, una barra de 100 g dura aproximadamente lo que dos o tres botellas de shampoo. Guárdala seca entre usos.</p>"
          }
        },
        "faq-2": {
          "type": "qa",
          "settings": {
            "q": "¿Sirven para cabello teñido?",
            "a": "<p>Sí. Todas nuestras barras son color safe y tienen pH balanceado.</p>"
          }
        },
        "faq-3": {
          "type": "qa",
          "settings": {
            "q": "¿Cómo se usa una barra?",
            "a": "<p>Moja tu cabello, activa la barra con agua, pásala de la raíz a las puntas, masajea y enjuaga.</p>"
          }
        }
      },
      "block_order": [
