{
  "name": "agente-publicador-redes-sociales",
  "version": "0.1.0",
  "private": true,
  "description": "Agente de contenido social con IA: analiza competencia, genera posts (texto, imagen, animación 2D), los manda a aprobación del cliente y publica en Instagram, Facebook y LinkedIn con las APIs oficiales.",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --no-warnings=ExperimentalWarning --env-file-if-exists=.env src/server.js",
    "dev": "node --no-warnings=ExperimentalWarning --env-file-if-exists=.env --watch src/server.js",
    "seed": "node --no-warnings=ExperimentalWarning --env-file-if-exists=.env scripts/seed-kuper.js",
    "render:demo": "node --env-file-if-exists=.env scripts/render-demo.js",
    "test": "node --no-warnings=ExperimentalWarning --test",
    "token-meta": "node --no-warnings=ExperimentalWarning --env-file-if-exists=.env scripts/token-meta.js",
    "actualizar-kuper": "node --no-warnings=ExperimentalWarning --env-file-if-exists=.env scripts/actualizar-kuper.js",
    "competencia-kuper": "node --no-warnings=ExperimentalWarning --env-file-if-exists=.env scripts/competencia-kuper.js",
    "probar-agenda": "node --no-warnings=ExperimentalWarning --env-file-if-exists=.env scripts/probar-agenda.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@fontsource/inter-tight": "^5.3.0",
    "express": "^5.1.0",
    "ffmpeg-static": "^5.3.0",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.13",
    "playwright": "~1.56.1"
  }
}
