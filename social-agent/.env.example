# Copia este archivo a .env y llena los valores.

PORT=3000
# URL pública (https) donde corre el agente. Instagram y Facebook descargan los
# medios desde aquí, así que en producción debe ser accesible desde internet.
PUBLIC_BASE_URL=http://localhost:3000
TIMEZONE=America/Mexico_City

# Panel de agencia
ADMIN_PASSWORD=cambia-esto
# Llave larga y aleatoria: cifra los tokens de los clientes. Si la cambias, hay que volver a capturar credenciales.
SECRET_KEY=genera-una-con-openssl-rand-base64-48

# Claude (texto, planeación y análisis de competencia)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=high
ANIMATOR_EFFORT=high   # esfuerzo del animador (xhigh = piezas más cuidadas, más lento)

# Gemini / Nano Banana (opcional, solo para marcas con "imagenes_ia": true). Sin esto, todo lo diseña el animador.
GEMINI_API_KEY=
# IA para escribir posts y animaciones: Gemini con la clave GRATIS de Google AI Studio va primero;
# si falla o se acaba su cupo del día, entra Claude (ANTHROPIC_API_KEY). Guárdala con deploy/clave.sh.
GEMINI_TEXT_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.8-flash
# GEMINI_TEXT_RESPALDO=gemini-3.6-flash,gemini-3.5-flash-lite   (si el principal está saturado o sin cupo)
# GEMINI_THINKING=low        (low | high | default)
# GEMINI_TIMEOUT_SEG=600     (cuánto esperar a Gemini antes de reintentar)
# POSTS_LLM_ORDEN=anthropic,gemini   (para que Claude vaya primero)
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Versiones de API (actualízalas cuando Meta/LinkedIn retiren las viejas)
META_GRAPH_VERSION=v24.0
LINKEDIN_API_VERSION=202609

# Pruebas
DRY_RUN=0        # 1 = no publica de verdad
MOCK_LLM=0       # 1 = no llama a Claude (contenido de prueba)
SCHEDULER=1      # 0 = desactiva el ciclo automático
LEAD_DAYS=7      # días de anticipación para generar cada post
MAX_PIEZAS_DIA=1 # piezas que genera al día (todas las de todos los clientes); cada video usa ~750 MB al renderizar
HORAS_GENERACION=01-06   # horas locales en que genera (de madrugada); vacío = a cualquier hora
COMPETITOR_REFRESH_DAYS=7
# CHROMIUM_PATH=/ruta/a/chromium   # opcional, si Playwright no encuentra su navegador

# Aviso por correo al cliente cuando tiene posts por revisar (uno al día como máximo, desde HORA_AVISO).
# El correo de cada cliente va en su configuración: "notificaciones": { "email": "...", "whatsapp": false }
HORA_AVISO=09:00
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# TikTok (opcional): app de la agencia en developers.tiktok.com con "Content Posting API" (Direct Post).
# Redirect URI a registrar en la app: https://TU-DOMINIO/admin/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Agente de ventas (opcional): búsqueda de empresas por giro y ciudad.
# Google Cloud -> APIs -> activar "Places API (New)" -> Credenciales -> Crear clave de API.
GOOGLE_PLACES_API_KEY=

# Fotos gratis para el agente de blog (pexels.com/api). Guárdala con deploy/clave.sh.
PEXELS_API_KEY=

# Facturación automática (Factura.com → Desarrolladores → API). Guárdalas con deploy/clave.sh.
FACTURACOM_API_KEY=
FACTURACOM_SECRET_KEY=
# FACTURACOM_SANDBOX=1   (ambiente de pruebas, sin validez fiscal)
